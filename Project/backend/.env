# Placeholder: Backend environment variables example
# Example:
# DATABASE_URL=sqlite+aiosqlite:///./test.db
# SECRET_KEY=your-secret
# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sensorhub
DB_USER=sensorhub_app
DB_PASSWORD=<ตั้งรหัสผ่านเอง>

# JWT
JWT_SECRET=<สุ่ม random string อย่างน้อย 32 ตัวอักษร>
JWT_EXPIRE_MINUTES=480

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=<ถ้าตั้ง auth ไว้บน mosquitto>
MQTT_PASSWORD=<ถ้าตั้ง auth ไว้บน mosquitto>

# CORS (ตอน dev) — production ใช้ same-origin ผ่าน Nginx จึงไม่จำเป็น
CORS_ORIGINS=http://localhost:5173